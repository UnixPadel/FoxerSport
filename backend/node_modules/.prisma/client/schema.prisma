datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  customer
  admin
  affiliate
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
  refunded
}

enum CouponType {
  percentage
  fixed_amount
  free_shipping
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(255)
  passwordHash       String               @map("password_hash") @db.VarChar(255)
  firstName          String               @map("first_name") @db.VarChar(100)
  lastName           String               @map("last_name") @db.VarChar(100)
  phone              String?              @db.VarChar(20)
  phoneCountry       String               @default("TR") @map("phone_country") @db.VarChar(5)
  role               UserRole             @default(customer)
  isActive           Boolean              @default(true) @map("is_active")
  emailVerified      Boolean              @default(false) @map("email_verified")
  preferredLang      String               @default("tr") @map("preferred_lang") @db.VarChar(5)
  preferredCurrency  String               @default("TRY") @map("preferred_currency") @db.VarChar(3)
  avatarUrl          String?              @map("avatar_url") @db.Text
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt        DateTime?            @map("last_login_at") @db.Timestamptz
  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  wishlistItems      WishlistItem[]
  cartItems          CartItem[]
  giftCertificates   GiftCertificate[]    @relation("GiftCertificatesSent")
  affiliateLinks     AffiliateLink[]
  blogPosts          BlogPost[]
  orderStatusChanges OrderStatusHistory[]
  adminActivityLogs  AdminActivityLog[]
  legacyId           Int?                 @unique @map("legacy_id")
  ReturnRequest      ReturnRequest[]
  BlogComment        BlogComment[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String?  @db.VarChar(50)
  firstName     String   @map("first_name") @db.VarChar(100)
  lastName      String   @map("last_name") @db.VarChar(100)
  company       String?  @db.VarChar(200)
  addressLine1  String   @map("address_line_1") @db.VarChar(255)
  addressLine2  String?  @map("address_line_2") @db.VarChar(255)
  city          String   @db.VarChar(100)
  district      String?  @db.VarChar(100)
  stateProvince String?  @map("state_province") @db.VarChar(100)
  postalCode    String   @map("postal_code") @db.VarChar(20)
  countryCode   String   @default("TR") @map("country_code") @db.VarChar(2)
  phone         String?  @db.VarChar(20)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  legacyId      Int?     @unique @map("legacy_id")

  @@index([userId])
  @@map("addresses")
}

model Category {
  id           Int                   @id @default(autoincrement())
  parentId     Int?                  @map("parent_id")
  slug         String                @unique @db.VarChar(100)
  imageUrl     String?               @map("image_url") @db.Text
  sortOrder    Int                   @default(0) @map("sort_order")
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  parent       Category?             @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryToCategory")
  translations CategoryTranslation[]
  products     Product[]
  legacyId     Int?                  @unique @map("legacy_id")

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model CategoryTranslation {
  id              Int      @id @default(autoincrement())
  categoryId      Int      @map("category_id")
  locale          String   @db.VarChar(5)
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  metaTitle       String?  @map("meta_title") @db.VarChar(200)
  metaDescription String?  @map("meta_description") @db.Text
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId, locale])
  @@map("category_translations")
}

model Product {
  id                String               @id @default(uuid()) @db.Uuid
  categoryId        Int?                 @map("category_id")
  sku               String               @unique @db.VarChar(50)
  slug              String               @unique @db.VarChar(255)
  priceTry          Decimal              @map("price_try") @db.Decimal(12, 2)
  priceEur          Decimal?             @map("price_eur") @db.Decimal(12, 2)
  priceUsd          Decimal?             @map("price_usd") @db.Decimal(12, 2)
  compareAtPriceTry Decimal?             @map("compare_at_price_try") @db.Decimal(12, 2)
  stockQuantity     Int                  @default(0) @map("stock_quantity")
  lowStockThreshold Int                  @default(5) @map("low_stock_threshold")
  weightGrams       Int?                 @map("weight_grams")
  isActive          Boolean              @default(true) @map("is_active")
  isFeatured        Boolean              @default(false) @map("is_featured")
  brand             String?              @db.VarChar(100)
  avgRating         Decimal              @default(0.0) @map("avg_rating") @db.Decimal(2, 1)
  reviewCount       Int                  @default(0) @map("review_count")
  viewCount         Int                  @default(0) @map("view_count")
  soldCount         Int                  @default(0) @map("sold_count")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  category          Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations      ProductTranslation[]
  images            ProductImage[]
  variants          ProductVariant[]
  reviews           Review[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  manufacturerId    Int?                 @map("manufacturer_id")
  manufacturer      Manufacturer?        @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  productAttributes ProductAttribute[]
  relatedToOthers   RelatedProduct[]     @relation("ProductHasRelated")
  relatedFromOthers RelatedProduct[]     @relation("ProductIsRelated")
  legacyId          Int?                 @unique @map("legacy_id")

  @@index([categoryId])
  @@index([slug])
  @@index([sku])
  @@index([isFeatured])
  @@index([isActive])
  @@map("products")
}

model ProductTranslation {
  id               Int     @id @default(autoincrement())
  productId        String  @map("product_id") @db.Uuid
  locale           String  @db.VarChar(5)
  name             String  @db.VarChar(300)
  shortDescription String? @map("short_description") @db.Text
  description      String? @db.Text
  metaTitle        String? @map("meta_title") @db.VarChar(200)
  metaDescription  String? @map("meta_description") @db.Text
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([productId, locale])
  @@map("product_translations")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId String  @map("product_id") @db.Uuid
  url       String  @db.Text
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id               String      @id @default(uuid()) @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  sku              String      @unique @db.VarChar(50)
  size             String?     @db.VarChar(20)
  color            String?     @db.VarChar(50)
  colorHex         String?     @map("color_hex") @db.VarChar(7)
  priceModifierTry Decimal     @default(0.00) @map("price_modifier_try") @db.Decimal(12, 2)
  priceModifierEur Decimal     @default(0.00) @map("price_modifier_eur") @db.Decimal(12, 2)
  priceModifierUsd Decimal     @default(0.00) @map("price_modifier_usd") @db.Decimal(12, 2)
  stockQuantity    Int         @default(0) @map("stock_quantity")
  isActive         Boolean     @default(true) @map("is_active")
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  rating     Int      @db.SmallInt
  title      String?  @db.VarChar(200)
  comment    String?  @db.Text
  isVerified Boolean  @default(false) @map("is_verified")
  isApproved Boolean  @default(false) @map("is_approved")
  isReported Boolean  @default(false) @map("is_reported")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  legacyId   Int?     @unique @map("legacy_id")

  @@unique([productId, userId])
  @@index([productId])
  @@index([isApproved])
  @@map("reviews")
}

model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String?         @map("user_id") @db.Uuid
  sessionId String?         @map("session_id") @db.VarChar(255)
  productId String          @map("product_id") @db.Uuid
  variantId String?         @map("variant_id") @db.Uuid
  quantity  Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model Order {
  id                      String               @id @default(uuid()) @db.Uuid
  orderNumber             String               @unique @map("order_number") @db.VarChar(20)
  userId                  String               @map("user_id") @db.Uuid
  shippingAddressId       String?              @map("shipping_address_id") @db.Uuid
  billingAddressSnapshot  Json                 @map("billing_address_snapshot")
  shippingAddressSnapshot Json                 @map("shipping_address_snapshot")
  status                  OrderStatus          @default(pending)
  currency                String               @default("TRY") @db.VarChar(3)
  subtotal                Decimal              @db.Decimal(12, 2)
  shippingCost            Decimal              @default(0.00) @map("shipping_cost") @db.Decimal(12, 2)
  taxAmount               Decimal              @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount          Decimal              @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  total                   Decimal              @db.Decimal(12, 2)
  couponId                String?              @map("coupon_id") @db.Uuid
  notes                   String?              @db.Text
  adminNotes              String?              @map("admin_notes") @db.Text
  trackingNumber          String?              @map("tracking_number") @db.VarChar(100)
  trackingUrl             String?              @map("tracking_url") @db.Text
  shippedAt               DateTime?            @map("shipped_at") @db.Timestamptz
  deliveredAt             DateTime?            @map("delivered_at") @db.Timestamptz
  cancelledAt             DateTime?            @map("cancelled_at") @db.Timestamptz
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user                    User                 @relation(fields: [userId], references: [id])
  shippingAddress         Address?             @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  coupon                  Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  statusHistory           OrderStatusHistory[]
  payments                Payment[]
  reviews                 Review[]
  legacyId                Int?                 @unique @map("legacy_id")
  ReturnRequest           ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  variantId       String?         @map("variant_id") @db.Uuid
  productSnapshot Json            @map("product_snapshot")
  quantity        Int
  unitPrice       Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice      Decimal         @map("total_price") @db.Decimal(12, 2)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  ReturnItem      ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   String   @map("order_id") @db.Uuid
  oldStatus String?  @map("old_status") @db.VarChar(30)
  newStatus String   @map("new_status") @db.VarChar(30)
  changedBy String?  @map("changed_by") @db.Uuid
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id                     String   @id @default(uuid()) @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  provider               String   @default("iyzico") @db.VarChar(30)
  providerPaymentId      String?  @map("provider_payment_id") @db.VarChar(255)
  providerConversationId String?  @map("provider_conversation_id") @db.VarChar(255)
  amount                 Decimal  @db.Decimal(12, 2)
  currency               String   @db.VarChar(3)
  status                 String   @db.VarChar(30)
  installment            Int      @default(1)
  cardLastFour           String?  @map("card_last_four") @db.VarChar(4)
  cardType               String?  @map("card_type") @db.VarChar(30)
  errorCode              String?  @map("error_code") @db.VarChar(50)
  errorMessage           String?  @map("error_message") @db.Text
  rawResponse            Json?    @map("raw_response")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  order                  Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model Coupon {
  id             String     @id @default(uuid()) @db.Uuid
  code           String     @unique @db.VarChar(50)
  type           CouponType
  value          Decimal    @db.Decimal(12, 2)
  currency       String?    @default("TRY") @db.VarChar(3)
  minOrderAmount Decimal?   @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?   @map("max_discount") @db.Decimal(12, 2)
  usageLimit     Int?       @map("usage_limit")
  usageCount     Int        @default(0) @map("usage_count")
  perUserLimit   Int        @default(1) @map("per_user_limit")
  validFrom      DateTime?  @map("valid_from") @db.Timestamptz
  validUntil     DateTime?  @map("valid_until") @db.Timestamptz
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  orders         Order[]

  @@index([code])
  @@map("coupons")
}

model GiftCertificate {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique @db.VarChar(50)
  fromUserId String?   @map("from_user_id") @db.Uuid
  toEmail    String    @map("to_email") @db.VarChar(255)
  toName     String?   @map("to_name") @db.VarChar(200)
  message    String?   @db.Text
  amount     Decimal   @db.Decimal(12, 2)
  balance    Decimal   @db.Decimal(12, 2)
  currency   String    @default("TRY") @db.VarChar(3)
  isActive   Boolean   @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  fromUser   User?     @relation("GiftCertificatesSent", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@map("gift_certificates")
}

model BlogPost {
  id            String                @id @default(uuid()) @db.Uuid
  slug          String                @unique @db.VarChar(255)
  authorId      String?               @map("author_id") @db.Uuid
  featuredImage String?               @map("featured_image") @db.Text
  isPublished   Boolean               @default(false) @map("is_published")
  publishedAt   DateTime?             @map("published_at") @db.Timestamptz
  viewCount     Int                   @default(0) @map("view_count")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  author        User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations  BlogPostTranslation[]
  comments      BlogComment[]

  @@map("blog_posts")
}

model BlogPostTranslation {
  id              Int      @id @default(autoincrement())
  postId          String   @map("post_id") @db.Uuid
  locale          String   @db.VarChar(5)
  title           String   @db.VarChar(300)
  excerpt         String?  @db.Text
  content         String   @db.Text
  metaTitle       String?  @map("meta_title") @db.VarChar(200)
  metaDescription String?  @map("meta_description") @db.Text
  post            BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@map("blog_post_translations")
}

model InfoPage {
  id           Int                   @id @default(autoincrement())
  slug         String                @unique @db.VarChar(100)
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  translations InfoPageTranslation[]

  @@map("info_pages")
}

model InfoPageTranslation {
  id              Int      @id @default(autoincrement())
  pageId          Int      @map("page_id")
  locale          String   @db.VarChar(5)
  title           String   @db.VarChar(200)
  content         String   @db.Text
  metaTitle       String?  @map("meta_title") @db.VarChar(200)
  metaDescription String?  @map("meta_description") @db.Text
  page            InfoPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@map("info_page_translations")
}

model Banner {
  id           Int                 @id @default(autoincrement())
  position     String              @db.VarChar(50)
  imageUrl     String              @map("image_url") @db.Text
  linkUrl      String?             @map("link_url") @db.Text
  sortOrder    Int                 @default(0) @map("sort_order")
  isActive     Boolean             @default(true) @map("is_active")
  startsAt     DateTime?           @map("starts_at") @db.Timestamptz
  endsAt       DateTime?           @map("ends_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  translations BannerTranslation[]

  @@map("banners")
}

model BannerTranslation {
  id         Int     @id @default(autoincrement())
  bannerId   Int     @map("banner_id")
  locale     String  @db.VarChar(5)
  title      String? @db.VarChar(200)
  subtitle   String? @db.Text
  buttonText String? @map("button_text") @db.VarChar(100)
  banner     Banner  @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, locale])
  @@map("banner_translations")
}

model ExchangeRate {
  id             Int      @id @default(autoincrement())
  baseCurrency   String   @default("TRY") @map("base_currency") @db.VarChar(3)
  targetCurrency String   @map("target_currency") @db.VarChar(3)
  rate           Decimal  @db.Decimal(12, 6)
  isManual       Boolean  @default(false) @map("is_manual")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([baseCurrency, targetCurrency])
  @@map("exchange_rates")
}

model AffiliateLink {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  code            String   @unique @db.VarChar(50)
  commissionRate  Decimal  @default(5.00) @map("commission_rate") @db.Decimal(4, 2)
  totalClicks     Int      @default(0) @map("total_clicks")
  totalOrders     Int      @default(0) @map("total_orders")
  totalRevenue    Decimal  @default(0.00) @map("total_revenue") @db.Decimal(12, 2)
  totalCommission Decimal  @default(0.00) @map("total_commission") @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affiliate_links")
}

model ShippingZone {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  countries     String[]
  flatRate      Decimal? @map("flat_rate") @db.Decimal(12, 2)
  freeAbove     Decimal? @map("free_above") @db.Decimal(12, 2)
  weightRates   Json?    @map("weight_rates")
  currency      String?  @default("TRY") @db.VarChar(3)
  estimatedDays String?  @map("estimated_days") @db.VarChar(20)
  isActive      Boolean  @default(true) @map("is_active")

  @@map("shipping_zones")
}

model AdminActivityLog {
  id         Int      @id @default(autoincrement())
  adminId    String   @map("admin_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(255)
  details    Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_activity_log")
}

// ==========================================
// NEW MODELS FOR OPENCART MIGRATION
// ==========================================

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("newsletter_subscribers")
}

model Manufacturer {
  id        Int      @id @default(autoincrement())
  legacyId  Int?     @unique @map("legacy_id")
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(100)
  imageUrl  String?  @map("image_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@map("manufacturers")
}

model AttributeGroup {
  id        Int  @id @default(autoincrement())
  legacyId  Int? @unique @map("legacy_id")
  sortOrder Int  @default(0) @map("sort_order")

  translations AttributeGroupTranslation[]
  attributes   Attribute[]

  @@map("attribute_groups")
}

model AttributeGroupTranslation {
  id               Int    @id @default(autoincrement())
  attributeGroupId Int    @map("attribute_group_id")
  locale           String @db.VarChar(5)
  name             String @db.VarChar(100)

  attributeGroup AttributeGroup @relation(fields: [attributeGroupId], references: [id], onDelete: Cascade)

  @@unique([attributeGroupId, locale])
  @@map("attribute_group_translations")
}

model Attribute {
  id        Int  @id @default(autoincrement())
  legacyId  Int? @unique @map("legacy_id")
  groupId   Int  @map("group_id")
  sortOrder Int  @default(0) @map("sort_order")

  group             AttributeGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  translations      AttributeTranslation[]
  productAttributes ProductAttribute[]

  @@map("attributes")
}

model AttributeTranslation {
  id          Int    @id @default(autoincrement())
  attributeId Int    @map("attribute_id")
  locale      String @db.VarChar(5)
  name        String @db.VarChar(100)

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, locale])
  @@map("attribute_translations")
}

model ProductAttribute {
  id          Int    @id @default(autoincrement())
  productId   String @map("product_id") @db.Uuid
  attributeId Int    @map("attribute_id")
  locale      String @db.VarChar(5)
  textValue   String @map("text_value") @db.Text

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId, locale])
  @@map("product_attributes")
}

enum ReturnStatus {
  pending
  authorized
  received
  refunded
  rejected
}

enum ReturnAction {
  refund
  replacement
  store_credit
}

model ReturnRequest {
  id           String        @id @default(uuid()) @db.Uuid
  legacyId     Int?          @unique @map("legacy_id")
  orderId      String        @map("order_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  status       ReturnStatus  @default(pending)
  action       ReturnAction?
  reason       String        @db.VarChar(255)
  customerNote String?       @map("customer_note") @db.Text
  adminNote    String?       @map("admin_note") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  order Order        @relation(fields: [orderId], references: [id])
  user  User         @relation(fields: [userId], references: [id])
  items ReturnItem[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id              String  @id @default(uuid()) @db.Uuid
  returnRequestId String  @map("return_request_id") @db.Uuid
  orderItemId     String  @map("order_item_id") @db.Uuid
  quantity        Int
  reasonDetail    String? @map("reason_detail") @db.Text

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@map("return_items")
}

model BlogComment {
  id         String   @id @default(uuid()) @db.Uuid
  legacyId   Int?     @unique @map("legacy_id")
  postId     String   @map("post_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  guestName  String?  @map("guest_name") @db.VarChar(100)
  guestEmail String?  @map("guest_email") @db.VarChar(255)
  content    String   @db.Text
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([isApproved])
  @@map("blog_comments")
}

model RelatedProduct {
  id               Int    @id @default(autoincrement())
  productId        String @map("product_id") @db.Uuid
  relatedProductId String @map("related_product_id") @db.Uuid

  product        Product @relation("ProductHasRelated", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductIsRelated", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@map("related_products")
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // ==========================================
  // NEW MODELS FOR MARKETING CAMPAIGNS
  // ==========================================

  @@map("settings")
}

enum CampaignType {
  email
  whatsapp
  mixed
}

enum TargetType {
  all
  specific
}

enum CampaignStatus {
  draft
  scheduled
  sending
  completed
  failed
}

model Campaign {
  id         String         @id @default(uuid()) @db.Uuid
  name       String         @db.VarChar(255)
  type       CampaignType
  targetType TargetType     @map("target_type")
  status     CampaignStatus @default(draft)

  subject   String? @db.VarChar(255)
  emailHtml String? @map("email_html") @db.Text
  emailJson Json?   @map("email_json")

  waMessage String? @map("wa_message") @db.Text

  targetIds String[] @map("target_ids") @db.Uuid

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("campaigns")
}

model CampaignLog {
  id           String   @id @default(uuid()) @db.Uuid
  campaignId   String   @map("campaign_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  contact      String   @db.VarChar(255) // email or phone number
  channel      String   @db.VarChar(20) // email or whatsapp
  status       String   @db.VarChar(20) // success, failed
  errorMessage String?  @map("error_message") @db.Text
  sentAt       DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@index([campaignId])
  @@map("campaign_logs")
}
